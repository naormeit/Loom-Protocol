LOOM_MODE=local
LOOM_HOST=127.0.0.1
LOOM_PORT=8080
LOOM_REQUIRE_SIGNATURE=false
LOOM_SHARED_SECRET=change-me-for-signed-local-demo
# Comma-separated extra origins allowed to call the API from a browser (e.g. the hosted website).
LOOM_ALLOWED_ORIGINS=
# Hash-chained audit log file (empty = off). Verify with: python -m core.audit verify <path>
LOOM_AUDIT_LOG=
# Per-agent rate limit (0 disables) and per-client-address limit (0 = off).
LOOM_RATE_LIMIT_AGENT_MAX=30
LOOM_RATE_LIMIT_AGENT_WINDOW=10
LOOM_RATE_LIMIT_IP_MAX=0
LOOM_RATE_LIMIT_IP_WINDOW=10

# Azure mode. Set LOOM_MODE=azure only after these are configured.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_BLOCK_THRESHOLD=4
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=loom
COSMOS_CONTAINER=locks
